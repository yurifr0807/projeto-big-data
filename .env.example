# ========================================================
# Configurações de Conexão com o PostgreSQL (Aiven)
# Copie este arquivo para .env e preencha com seus dados:
# cp .env.example .env
# ========================================================

DB_HOST=seu-servico-postgresql.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=sua-senha-segura
DB_SSLMODE=require
