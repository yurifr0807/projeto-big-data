# ========================================================
# Configurações de Conexão com o PostgreSQL (Aiven)
# Copie este arquivo para .env e preencha com seus dados:
#   PowerShell: Copy-Item .env.example .env
#
# NOTA: O host e a porta reais são informados pelo console da Aiven
# ou pelos outputs do Terraform. Os valores abaixo são apenas exemplos
# fictícios; não use este arquivo como fonte de credenciais reais.
# ========================================================

DB_HOST=pg-<servico>-<projeto>.k.aivencloud.com
DB_PORT=17025
DB_NAME=observatorio
DB_USER=avnadmin
DB_PASSWORD=defina-uma-senha-local-ficticia
DB_SSLMODE=require

# ========================================================
# Ingestão: CA confiável (opcional)
# Use somente se sua rede/proxy usa uma CA própria. Aponte para o
# arquivo .pem da CA. A verificação TLS nunca é desativada.
# ========================================================
# CA_BUNDLE=C:\caminho\para\ca.pem

# ========================================================
# Terraform (NÃO coloque o token em arquivos; exporte no terminal)
# PowerShell: $env:AIVEN_TOKEN = "<token>"
# O nome legado AIVEN_API_TOKEN é aceito apenas pelo script auxiliar
# etl/consultar_servico_aiven.py, como fallback de compatibilidade.
# ========================================================
